<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MSBuildProjectDirectory)/default.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" PrivateAssets="all" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.5.1" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.1.0" PrivateAssets="all" />
    <Compile Include="Steps/**/*.cs" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
